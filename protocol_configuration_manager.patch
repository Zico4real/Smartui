+def _ikev2_status(ports_dict):
+    """IKEv2 and L2TP/IPsec share ONE strongSwan (charon) process, so the
+    service being active is not enough - IKEv2 only counts as ON when ITS OWN
+    connection file exists. The live IKE/NAT-T ports are read straight from
+    the charon config (the source of truth) and written back to ports_dict."""
+    try:
+        import vpn_common as vc
+    except Exception:
+        return "%s[OFF]%s" % (C_RED, C_RESET), None
+    if not os.path.exists(vc.IKEV2_CONF) or not _service_active(vc.STRONGSWAN_UNIT):
+        return "%s[OFF]%s" % (C_RED, C_RESET), None
+    ike, natt = vc.get_charon_ports()
+    ports_dict['IKEV2_PORT'] = str(ike)
+    ports_dict['IKEV2_NATT_PORT'] = str(natt)
+    detail = "%d,%d" % (ike, natt)
+    if check_system_port_in_use(ike, ("udp",)) and check_system_port_in_use(natt, ("udp",)):
+        return "%s[ON]%s" % (C_GREEN, C_RESET), detail
+    return "%s[ON?]%s" % (C_YELLOW, C_RESET), detail
+
+
+def _l2tp_status(ports_dict):
+    """L2TP needs xl2tpd, and in IPsec mode also strongSwan. The detail lists
+    every port a customer's device really talks to: IKE + NAT-T + L2TP for
+    L2TP/IPsec, or just the L2TP port in plain mode."""
+    try:
+        import vpn_common as vc
+        import l2tp_manager as l2m
+    except Exception:
+        return "%s[OFF]%s" % (C_RED, C_RESET), None
+    if not l2m._installed() or not _service_active("xl2tpd"):
+        return "%s[OFF]%s" % (C_RED, C_RESET), None
+    meta = l2m._load_meta()
+    port = l2m.get_port()
+    ports_dict['L2TP_PORT'] = str(port)
+    ports_dict['L2TP_MODE'] = meta["mode"]
+    needed = [port]
+    detail = str(port)
+    if meta["mode"] == "ipsec":
+        if not _service_active(vc.STRONGSWAN_UNIT):
+            return "%s[OFF]%s" % (C_RED, C_RESET), None
+        ike, natt = vc.get_charon_ports()
+        ports_dict['L2TP_IKE_PORT'] = str(ike)
+        ports_dict['L2TP_NATT_PORT'] = str(natt)
+        needed += [ike, natt]
+        detail = "%d,%d,%d" % (ike, natt, port)
+    if all(check_system_port_in_use(p, ("udp",)) for p in needed):
+        return "%s[ON]%s" % (C_GREEN, C_RESET), detail
+    return "%s[ON?]%s" % (C_YELLOW, C_RESET), detail
+
